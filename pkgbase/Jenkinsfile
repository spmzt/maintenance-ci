pipeline {
	agent {
		label 'host && freebsd'
	}

	parameters {
		string(name: 'basejail', defaultValue: '/usr/jails/basejail',
				description: 'Set it to your base jail directory')
		string(name: 'zfsds', defaultValue: 'tank/jails',
				description: 'Set it to the zfs dataset that containes your jails')
		booleanParam(name: 'skip_pull', defaultValue: false,
				description: 'Set to true to skip the git pull stage')
		string(name: 'jobs', defaultValue: '24',
				description: 'Set to your desired concurrent jobs')
	}
	stages {
		stage("pull") {
			when { expression { params.skip_pull != true } }
			steps {
				sh 'mdo git -C /usr/src pull'
			}
		}
		stage("poudriere") {
			steps {
				sh 'mdo poudriere jail -u -jFreeBSD:16:amd64 -K GENERIC-NODEBUG -B -b'
			}
		}
		stage("basejail") {
			steps {
				sh "mdo zfs snapshot -r ${params.zfsds}@`date -I`-${currentBuild.number}"
				sh "mdo pkg -c ${params.basejail} upgrade -y"
			}
		}
	}
}
