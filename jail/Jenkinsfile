pipeline {
	agent {
		label 'host && freebsd'
	}

	parameters {
		string(name: 'registry', defaultValue: 'zot.spmzt.net',
				description: 'Set your registry URL')
	}

	stages {
		stage("buildah_from_scratch") {
			steps {
				sh '''
					export HASH="$(mdo buildah from scratch)"
					export MOUNT="$(mdo buildah mount ${HASH})"
					mdo pkg -r ${MOUNT} install -y FreeBSD-set-minimal-jail FreeBSD-set-optional-jail
					mdo pkg -r ${MOUNT} install -y pkg zsh zsh-autosuggestions zsh-completions vim-tiny
					mdo buildah umount ${HASH}
					mdo buildah commit ${HASH} freebsd-base:latest
				'''
			}
		}
		stage("tag") {
			steps {
				sh "mdo podman tag freebsd-base:latest ${params.registry}/freebsd-base:latest"
				sh "mdo podman tag freebsd-base:latest ${params.registry}/freebsd-base:`date -I`"
			}
		}
		stage("push") {
			steps {
				sh "mdo podman push ${params.registry}/freebsd-base:latest"
				sh "mdo podman push ${params.registry}/freebsd-base:`date -I`"
			}
		}
	}
}
