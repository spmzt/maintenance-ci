// Build a minimal FreeBSD container image from pkgbase and push it to the
// registry as both :latest and :YYYY-MM-DD.
pipeline {
	agent {
		label 'host && freebsd'
	}

	parameters {
		string(name: 'registry', defaultValue: 'zot.spmzt.net',
				description: 'Container registry to push to')
		string(name: 'image', defaultValue: 'freebsd-base',
				description: 'Image name')
	}

	environment {
		IMAGE = "${params.registry}/${params.image}"
	}

	stages {
		stage('build') {
			steps {
				sh '''
					CTR=$(mdo buildah from scratch)
					trap 'mdo buildah rm "$CTR"' EXIT
					MNT=$(mdo buildah mount "$CTR")
					mdo pkg -r "$MNT" install -y FreeBSD-set-minimal-jail FreeBSD-set-optional-jail
					mdo pkg -r "$MNT" install -y pkg zsh zsh-autosuggestions zsh-completions vim-tiny
					mdo rm -rf "$MNT"/var/cache/pkg
					mdo buildah umount "$CTR"
					mdo buildah commit "$CTR" "$IMAGE:latest"
				'''
			}
		}
		stage('push') {
			steps {
				sh '''
					TAG=$(date -I)
					mdo podman tag "$IMAGE:latest" "$IMAGE:$TAG"
					mdo podman push "$IMAGE:latest"
					mdo podman push "$IMAGE:$TAG"
				'''
			}
		}
	}
}
